# Local demo is the default. Existing Supabase/Gemini values are never used for
# database writes unless CLAIMPILOT_STORAGE is explicitly set to supabase.
CLAIMPILOT_STORAGE=local
# Optional local persistence override; default is .claimpilot/ (gitignored).
# CLAIMPILOT_DATA_DIR=

# Required for hosted demos; optional for local development.
APP_PASSCODE=
# Use a long random secret. Falls back to APP_PASSCODE; local-only default otherwise.
APP_SESSION_SECRET=

# Optional AI receipt intelligence and conversational function calling.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# For a designated DEVELOPMENT Supabase project, after applying schema and seed.
# Never prefix these with NEXT_PUBLIC_. Never commit real credentials.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
